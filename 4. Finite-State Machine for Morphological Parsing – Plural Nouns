def plural_fsm(word):
    state = "q0"
    path = [state]
    if word.endswith(("s", "x", "z", "ch", "sh")):
        state = "q1"
        path.append(state)
        plural = word + "es"
        state = "q2"
        path.append(state)
    elif word.endswith("y") and len(word) > 1 and word[-2] not in "aeiou":
        state = "q3"
        path.append(state)
        plural = word[:-1] + "ies"
        state = "q2"
        path.append(state)
    else:
        state = "q4"
        path.append(state)
        plural = word + "s"
        state = "q2"
        path.append(state)
    return plural, path
nouns = ["cat", "dog", "bus", "box", "watch", "dish", "baby", "book"]
for noun in nouns:
    plural, path = plural_fsm(noun)
    print("Singular:", noun)
    print("State Path:", " -> ".join(path))
    print("Plural:", plural)
    print()
