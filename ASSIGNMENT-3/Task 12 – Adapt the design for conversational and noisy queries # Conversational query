query = "hi the student check the fee".split()
query = [w.lower() for w in query]
print("Normalized:", query)
new_grammar = CFG.fromstring("""
S -> Greeting S | NP VP
NP -> Det N | N
VP -> V NP | V
Greeting -> 'hi'
Det -> 'the' | 'a'
N -> 'student' | 'bus' | 'fee' | 'ticket'
V -> 'check' | 'book' | 'pay' | 'show'
""")
parser = EarleyChartParser(new_grammar)
trees = list(parser.parse(query))
print("Parse found:", bool(trees))
