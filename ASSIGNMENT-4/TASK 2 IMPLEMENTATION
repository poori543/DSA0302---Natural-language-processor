# Meaning Structure

knowledge_base = {
    "Ravi": {"service": 12, "retired": True},
    "Arun": {"service": 5, "retired": True}
}

def check_eligibility(name):
    if name not in knowledge_base:
        return "Unknown"

    person = knowledge_base[name]

    if person["retired"] and person["service"] >= 10:
        return "True"
    else:
        return "False"

print("Ravi:", check_eligibility("Ravi"))
print("Arun:", check_eligibility("Arun"))
print("Meena:", check_eligibility("Meena"))

