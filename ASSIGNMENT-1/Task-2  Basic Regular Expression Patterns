import re
import random
import pandas as pd
print("TASK 2 - BASIC REGULAR EXPRESSION PATTERNS")
print("=" * 60)
operators = {
    "Concatenation": (r"BP", "BP"),
    "Disjunction": (r"fever|pain", "fever"),
    "Kleene Star": (r"ab*", "abb"),
    "Plus": (r"ab+", "ab"),
    "Optionality": (r"colou?r", "colour"),
    "Character Class": (r"[0-9]", "5"),
    "Range": (r"[A-Z]", "H"),
    "Negated Class": (r"[^0-9]+", "patient"),
    "Anchors": (r"^BP$", "BP"),
    "Counters": (r"[0-9]{10}", "9876543210")
}
print("\n1. BASIC REGEX OPERATORS")
for name, (pattern, example) in operators.items():
    print(name, ":", pattern, "->", bool(re.fullmatch(pattern, example)))
random.seed(42)
records = []
for i in range(500):
    record = (
        f"Patient ID: HSP{1000+i}. "
        f"Admission Date: 12/03/2025. "
        f"Discharge Date: 18-03-2025. "
        f"Drug: Paracetamol 500 mg. "
        f"Frequency: Twice daily. "
        f"Hb: 12.5 g/dL. "
        f"BP: 120/80 mmHg. "
        f"Temperature: 37.2 C. "
        f"ICD: E11.9. "
        f"Ward: General Bed: 12. "
        f"Contact: 9876543210. "
        f"Age: 45 years. "
        f"Symptom duration: 5 days."
    )
    if i < 10:
        record = record.replace(
            f"HSP{1000+i}",
            f"HSP-{1000+i}"
        )
    records.append(record)
print("\n2. DATASET INFORMATION")
print("Total records:", len(records))
print("Record types: Discharge, Prescription, Operation, Nursing")
patterns = {
    "Patient ID": r"(?<![A-Za-z0-9])HSP\d{4,8}(?!\d)",
    "Admission Date": r"(?<=Admission Date: )\d{1,2}/\d{1,2}/\d{4}",
    "Discharge Date": r"(?<=Discharge Date: )\d{1,2}-\d{1,2}-\d{4}",
    "Drug with Strength": r"\b[A-Za-z]+\s+\d+\s?mg\b",
    "Dosage Frequency": r"(?i)\b(?:once|twice|three times|four times)\s+daily\b",
    "Laboratory Value": r"\b\d+(?:\.\d+)?\s?(?:g/dL|mg/dL)\b",
    "Blood Pressure": r"\b\d{2,3}/\d{2,3}\s?mmHg\b",
    "Temperature": r"\b\d{2}(?:\.\d+)?\s?°?C\b",
    "ICD Code": r"\b[A-Z]\d{2}(?:\.\d{1,4})?\b",
    "Ward and Bed": r"\bWard:\s*[A-Za-z]+\s+Bed:\s*\d+\b",
    "Contact Number": r"\b[6-9]\d{9}\b",
    "Age": r"(?<=Age: )\d{1,3}\s+years\b",
    "Symptom Duration": r"(?<=Symptom duration: )\d+\s+(?:days|weeks|months)\b"
}
print("\n3. CLINICAL ENTITY PATTERNS")
for name, pattern in patterns.items():
    print(name, ":", pattern)
results = []
for name, pattern in patterns.items():
    tp = 0
    fp = 0
    fn = 0
    for record in records:
        matches = re.findall(pattern, record)
        if name == "Patient ID":
            if "HSP-" in record:
                expected = re.search(r"HSP-\d+", record).group()
                if expected in matches:
                    tp += 1
                else:
                    fn += 1
            else:
                expected = re.search(r"HSP\d+", record).group()
                if expected in matches:
                    tp += 1
                else:
                    fn += 1
        else:
            if matches:
                tp += 1
            else:
                fn += 1
    results.append([name, tp, fp, fn])
df = pd.DataFrame(
    results,
    columns=["Entity", "TP", "FP", "FN"]
)
print("\n4. PATTERN EVALUATION")
print(df.to_string(index=False))
print("\n5. GREEDY AND NON-GREEDY MATCHING")
sentence = "Drug: Paracetamol 500 mg and Amoxicillin 250 mg prescribed."
greedy = re.search(r"Drug:.*mg", sentence)
non_greedy = re.search(r"Drug:.*?mg", sentence)
print("Original:", sentence)
print("Greedy:", greedy.group())
print("Non-greedy:", non_greedy.group())
print("\n6. OPERATOR PRECEDENCE")
wrong = r"Admission|Discharge Date:\s*\d{4}"
correct = r"(?:Admission|Discharge) Date:\s*\d{4}"
test = "Admission Date: 2025"
print("Wrong pattern result:", bool(re.fullmatch(wrong, test)))
print("Correct pattern result:", bool(re.fullmatch(correct, test)))
print("\nTASK 2 COMPLETED SUCCESSFULLY!")
