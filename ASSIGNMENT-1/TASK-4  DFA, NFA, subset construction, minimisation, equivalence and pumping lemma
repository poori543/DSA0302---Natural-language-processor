from collections import deque
import re
def run_dfa(s, trans, start, finals, classify):
    q=start
    for ch in s: q=trans.get((q,classify(ch)),"DEAD")
    return q in finals
def show(name, states, alphabet, trans, start, finals):
    print("\n"+name+"\nTransition diagram (edges):")
    for (a,b),c in trans.items(): print(f"{a} --{b}--> {c}")
    print("Transition table")
    print("state | "+" | ".join(alphabet))
    for q in states: print(q,"|"," | ".join(trans.get((q,a),"DEAD") for a in alphabet))
    print("start =",start," final =",finals)
