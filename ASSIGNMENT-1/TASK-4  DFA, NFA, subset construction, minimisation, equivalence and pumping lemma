NFA={ (2,"P"):{1},(1,"D"):{3},(3,"D"):{4},(4,"D"):{5},(5,"D"):{6} }
EPS={0:{1,2}}; FINAL={6}; ALPHA=["P","D"]
def closure(S):
    S=set(S); todo=list(S)
    while todo:
        q=todo.pop()
        for z in EPS.get(q,set()):
            if z not in S: S.add(z); todo.append(z)
    return frozenset(S)
def move(S,a):
    out=set()
    for q in S: out |= NFA.get((q,a),set())
    return closure(out)
def trace(seq):
    S=closure({0}); print("epsilon closure:",sorted(S))
    for a in seq: S=move(S,a); print("after",a,":",sorted(S))
    print("ACCEPT" if FINAL.intersection(S) else "REJECT")
print("\nNFA accepted trace P D D D D"); trace(["P","D","D","D","D"])
print("NFA rejected trace P D D D"); trace(["P","D","D","D"])
start=closure({0}); subsets=[start]; seen={start}; todo=deque([start]); ST={}
while todo:
    S=todo.popleft()
    for a in ALPHA:
        U=move(S,a) or frozenset({"DEAD"})
        ST[S,a]=U
        if U not in seen: seen.add(U); subsets.append(U); todo.append(U)
dead=frozenset({"DEAD"})
for a in ALPHA: ST[dead,a]=dead
def label(S): return "{"+",".join(str(x) for x in sorted(S,key=str))+"}"
print("\nSubset construction table")
print("subset | P | D | final")
for S in subsets:
    print(label(S),"|",label(ST[S,"P"]),"|",label(ST[S,"D"]),"|",bool(FINAL.intersection(S)))
print("NFA states =",7,"; reachable DFA subset states including dead =",len(subsets))
finals={S for S in subsets if FINAL.intersection(S)}
parts=[p for p in [finals,set(subsets)-finals] if p]
change=True
while change:
    change=False; refined=[]
    for group in parts:
        buckets={}
        for S in group:
            sig=tuple(next(i for i,p in enumerate(parts) if ST[S,a] in p) for a in ALPHA)
            buckets.setdefault(sig,set()).add(S)
        refined.extend(buckets.values())
        if len(buckets)>1: change=True
    parts=refined
print("\nMinimisation groups:")
for i,p in enumerate(parts): print("M"+str(i),[label(s) for s in p])
print("DFA states before =",len(subsets),"; after =",len(parts))
