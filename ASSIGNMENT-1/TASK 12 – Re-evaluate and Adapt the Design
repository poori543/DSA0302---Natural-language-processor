def retrieve(query, docs, adapted=False):
    query_words = set(re.findall(r"[a-z]+", query.lower()))
    if adapted:
        query_words = {correct_word(w) for w in query_words}
    results = set()
    for i, doc in enumerate(docs):
        doc_words = set(re.findall(r"[a-z]+", doc.lower()))
        if adapted:
            doc_words = {correct_word(w) for w in doc_words}
        if query_words & doc_words:
            results.add(i)
    return results
def retrieval_evaluation(adapted):
    total_tp = total_fp = total_fn = 0
    for query, relevant in zip(queries, relevant_documents):
        retrieved = retrieve(query, documents, adapted)
        total_tp += len(retrieved & relevant)
        total_fp += len(retrieved - relevant)
        total_fn += len(relevant - retrieved)
    return calculate_metrics(total_tp, total_fp, total_fn)
