def extract_entities(text):
    results = {}
    for name, pattern in patterns.items():
        results[name] = re.findall(pattern, text, re.I)
    return results
def original_fsa(word):
    """
    Simple exact-match lexical automaton.
    Accepts only words present in English lexicon.
    """
    state = 0
    for char in word.lower():
        if char.isalpha():
            state += 1
        else:
            return False
    return word.lower() in english_lexicon
def original_analyser(word):
    word = word.lower()
    suffixes = ["ing", "ed", "ly", "ness", "s"]
    for suffix in suffixes:
        if word.endswith(suffix) and len(word) > len(suffix) + 2:
            return word[:-len(suffix)]
    return word
def ocr_normalise(text):
    text = re.sub(r"-\s*\n\s*", "", text)
    text = re.sub(
        r"(?<=[a-z])rn(?=[aeiouy]|$)",
        "m",
        text,
        flags=re.I
    )
    text = re.sub(
        r"(?<=\d)O(?=\d|mg|ml)",
        "0",
        text,
        flags=re.I
    )

    text = re.sub(
        r"(?<![A-Za-z])O(?=\d)",
        "0",
        text
    )

    text = re.sub(
        r"(?<=\d)O",
        "0",
        text
    )

    return text
def edit_distance(a, b):
    dp = [[0] * (len(b) + 1) for _ in range(len(a) + 1)]
    for i in range(len(a) + 1):
        dp[i][0] = i
    for j in range(len(b) + 1):
        dp[0][j] = j
    for i in range(1, len(a) + 1):
        for j in range(1, len(b) + 1):
            cost = 0 if a[i-1] == b[j-1] else 1
            dp[i][j] = min(
                dp[i-1][j] + 1,
                dp[i][j-1] + 1,
                dp[i-1][j-1] + cost
            )
    return dp[-1][-1]
def correct_word(word):
    word = word.lower()
    if word in combined_lexicon:
        return word
    best_word = word
    minimum_distance = 2
    for candidate in combined_lexicon:
        distance = edit_distance(word, candidate)
        if distance < minimum_distance:
            minimum_distance = distance
            best_word = candidate
    return best_word
def identify_language(word):
    word = word.lower()
    if word in english_lexicon:
        return "English"
    elif word in regional_lexicon:
        return "Regional"
    else:
        return "Unknown"
def improved_analyser(word):
    word = word.lower()
    if word in regional_meanings:
        return regional_meanings[word]
    if word in combined_lexicon:
        return word
    suffixes = ["ing", "ed", "ly", "ness", "s"]
    for suffix in suffixes:
        if word.endswith(suffix) and len(word) > len(suffix) + 2:
            return word[:-len(suffix)]
    return word
def improved_pipeline(text):
    text = ocr_normalise(text)
    tokens = re.findall(r"[A-Za-z]+|\d+(?:\.\d+)?", text)
    corrected = [correct_word(w) for w in tokens]
    languages = [identify_language(w) for w in corrected]
    analysed = [improved_analyser(w) for w in corrected]
    entities = extract_entities(text)
    return text, tokens, corrected, languages, analysed, entities
