ocr_text = "patlent has fracturе and diab etes"
print("\n5. OCR ERROR HANDLING")
print("Original OCR text:", ocr_text)
corrections = {
    "patlent": "patient",
    "fracturе": "fracture",
    "diab etes": "diabetes"
}
corrected_text = ocr_text
for wrong, correct in corrections.items():
    corrected_text = corrected_text.replace(wrong, correct)
print("Corrected text:", corrected_text)
mixed_text = "Patient ku fever irukku and doctor medicine kuduthar."
print("\n6. CODE-MIXED LANGUAGE PROCESSING")
print("Original sentence:", mixed_text)
tamil_dictionary = {
    "ku": "to",
    "irukku": "has",
    "kuduthar": "gave"
}
tokens = mixed_text.lower().split()
normalised_tokens = [
    tamil_dictionary.get(token.strip(".,!?"), token)
    for token in tokens
]
print("Normalised tokens:", normalised_tokens)
print("Note: This is a small demonstration dictionary, not a complete translator.")
word_forms = ["fracture", "fractured", "fractures", "fracturing"]
print("\n7. MORPHOLOGICAL ANALYSIS")
for word in word_forms:
    if word.endswith("ing"):
        root = word[:-3]
        feature = "Present participle"
    elif word.endswith("ed"):
        root = word[:-2]
        feature = "Past tense"
    elif word.endswith("s"):
        root = word[:-1]
        feature = "Plural"
    else:
        root = word
        feature = "Base form"
    print(f"{word:15} -> Root: {root:12} Feature: {feature}")
print("\n8. SEARCH IN NLP")
