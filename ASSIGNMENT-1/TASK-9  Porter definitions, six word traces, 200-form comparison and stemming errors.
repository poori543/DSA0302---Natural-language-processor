VOWELS = "aeiou"
def is_consonant(word, i):
    if word[i] in VOWELS:
        return False
    if word[i] == "y":
        if i == 0:
            return True
        return not is_consonant(word, i - 1)
    return True
def cv_pattern(word):
    return "".join(
        "C" if is_consonant(word, i) else "V"
        for i in range(len(word))
    )
def measure_m(word):
    pattern = cv_pattern(word)
    return sum(
        pattern[i:i+2] == "VC"
        for i in range(len(pattern) - 1)
    )
def has_vowel(word):
    return any(
        not is_consonant(word, i)
        for i in range(len(word))
    )
def double_consonant(word):
    return (
        len(word) >= 2
        and word[-1] == word[-2]
        and is_consonant(word, len(word) - 1)
    )
def cvc_condition(word):
    if len(word) < 3:
        return False
    return (
        is_consonant(word, len(word)-3)
        and not is_consonant(word, len(word)-2)
        and is_consonant(word, len(word)-1)
        and word[-1] not in "wxy"
    )
