def porter_trace(word):
    print("\nOriginal word:", word)
    word = porter._step1a(word)
    print("Step 1a:", word)
    word = porter._step1b(word)
    print("Step 1b:", word)
    word = porter._step1c(word)
    print("Step 1c:", word)
    word = porter._step2(word)
    print("Step 2:", word)
    word = porter._step3(word)
    print("Step 3:", word)
    word = porter._step4(word)
    print("Step 4:", word)
    word = porter._step5a(word)
    print("Step 5a:", word)
    word = porter._step5b(word)
    print("Step 5b:", word)
    print("Final stem:", word)
