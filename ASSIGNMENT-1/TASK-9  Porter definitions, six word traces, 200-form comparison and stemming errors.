def tokenize(text):
    return re.findall(r"[a-z]+", text.lower())
def normalize(word, method):
    if method == "No stemming":
        return word
    if method == "Porter":
        return porter.stem(word)
    if method == "Full morphology":
        return retrieval_fst.get(word, word)
    return word
def retrieve(query, method):
    query_terms = set(
        normalize(w, method)
        for w in tokenize(query)
    )
    found = []
    for doc_id, content in documents.items():
        doc_terms = set(
            normalize(w, method)
            for w in tokenize(content)
        )
        if query_terms.intersection(doc_terms):
            found.append(doc_id)
    return found
def calculate_metrics(method):
    correct = 0
    retrieved_count = 0
    relevant_count = 0
    for item in queries:
        qid = item["query_id"]
        query = item["query"]
        retrieved = retrieve(query, method)
        relevant = relevance[qid]
        correct += len(set(retrieved) & relevant)
        retrieved_count += len(retrieved)
        relevant_count += len(relevant)
    precision = (
        correct / retrieved_count
        if retrieved_count else 0
    )
    recall = (
        correct / relevant_count
        if relevant_count else 0
    )
    f1 = (
        2 * precision * recall / (precision + recall)
        if precision + recall else 0
    )
    return {
        "Method": method,
        "Precision": round(precision, 3),
        "Recall": round(recall, 3),
        "F1 Score": round(f1, 3)
    }
