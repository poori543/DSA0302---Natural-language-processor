import nltk
nltk.download('punkt')
nltk.download('punkt_tab')
nltk.download('wordnet')
nltk.download('omw-1.4')
from nltk.tokenize import word_tokenize
from nltk.stem import PorterStemmer
from nltk.stem import WordNetLemmatizer
text = "The children are playing happily and the dogs are running."
words = word_tokenize(text)
stemmer = PorterStemmer()
lemmatizer = WordNetLemmatizer()
print("Original Text:")
print(text)
print("\nMorphological Analysis:")
print("Word\t\tStem\t\tLemma")
for word in words:
    if word.isalpha():
        stem = stemmer.stem(word)
        # Use plural/verb forms where possible
        if word.lower() == "children":
            lemma = lemmatizer.lemmatize(word, pos='n')
        elif word.lower() in ["playing", "running"]:
            lemma = lemmatizer.lemmatize(word, pos='v')
        elif word.lower() == "dogs":
            lemma = lemmatizer.lemmatize(word, pos='n')
        else:
            lemma = lemmatizer.lemmatize(word)
        print(f"{word:12} {stem:12} {lemma}")
