import nltk
nltk.download('averaged_perceptron_tagger_eng')
nltk.download('wordnet')
nltk.download('omw-1.4')
from nltk import word_tokenize, pos_tag
from nltk.stem import WordNetLemmatizer
sentence = "The students are playing games and the boy walked home."
words = word_tokenize(sentence)
tagged_words = pos_tag(words)
lemmatizer = WordNetLemmatizer()
def get_wordnet_pos(tag):
    if tag.startswith('N'):
        return 'n'
    elif tag.startswith('V'):
        return 'v'
    elif tag.startswith('J'):
        return 'a'
    elif tag.startswith('R'):
        return 'r'
    return 'n'
print("MORPHOLOGICAL ANALYSIS")
print("-" * 75)
print(f"{'Word':<15}{'POS':<12}{'Lemma':<15}{'Features'}")
print("-" * 75)
for word, tag in tagged_words:
    wn_pos = get_wordnet_pos(tag)
    lemma = lemmatizer.lemmatize(word.lower(), wn_pos)
    if tag.startswith('N'):
        if tag == 'NNS' or tag == 'NNPS':
            feature = "Number: Plural"
        else:
            feature = "Number: Singular"
    elif tag.startswith('V'):
        if tag == 'VBD' or tag == 'VBN':
            tense = "Past"
        elif tag == 'VBG':
            tense = "Present participle (-ing)"
        elif tag == 'VBZ':
            tense = "Present, 3rd person singular"
        elif tag == 'VBP':
            tense = "Present"
        else:
            tense = "Base form"
        feature = "Tense/Form: " + tense
    else:
        feature = "Not applicable"
    print(f"{word:<15}{tag:<12}{lemma:<15}{feature}")
