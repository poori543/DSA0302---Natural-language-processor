import nltk
from nltk import word_tokenize, pos_tag
from nltk.stem import WordNetLemmatizer
nltk.download('punkt_tab')
nltk.download('averaged_perceptron_tagger_eng')
nltk.download('wordnet')
nltk.download('omw-1.4')
sentence = "The students are playing games and the boy walked home."
lemmatizer = WordNetLemmatizer()
words = word_tokenize(sentence)
tagged_words = pos_tag(words)
print("WORD\t\tPOS\t\tLEMMA\t\tGRAMMATICAL FEATURE")
print("-" * 75)
for word, tag in tagged_words:
    if tag.startswith('N'):
        pos = 'n'
    elif tag.startswith('V'):
        pos = 'v'
    elif tag.startswith('J'):
        pos = 'a'
    elif tag.startswith('R'):
        pos = 'r'
    else:
        pos = 'n'
    lemma = lemmatizer.lemmatize(word, pos=pos)
    if tag in ('NN', 'NNS', 'NNP', 'NNPS'):
        if tag in ('NNS', 'NNPS'):
            feature = "Plural noun"
        else:
            feature = "Singular noun"
    elif tag.startswith('V'):
        if tag == 'VBD':
            feature = "Past tense"
        elif tag in ('VBP', 'VBZ'):
            feature = "Present tense"
        elif tag == 'VBG':
            feature = "Present participle"
        elif tag == 'VBN':
            feature = "Past participle"
        elif tag == 'VB':
            feature = "Base form"
        else:
            feature = "Verb"
    else:
        feature = "-"
    print(f"{word:<15}{tag:<12}{lemma:<15}{feature}")
